# Copy to .env and fill values (or set in hosting panel)
DB_HOST=localhost
DB_NAME=job_portal
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Internal API key (must match across endpoints)
API_KEY=CHANGE_ME_API_KEY

# HuggingFace token (optional; required for AI keyword extraction / NER)
HF_TOKEN=

# Razorpay (optional; required for payments)
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=

# HTTP/SSL behavior
FORCE_HTTP=1
ALLOW_HTTPS_URLS=0

# Disable SSL verification (NOT recommended for production)
CURL_INSECURE_INTERNAL=1
CURL_INSECURE_EXTERNAL=1
